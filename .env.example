# QueryMind Environment Configuration

# Optional: Google Gemini API Key for LLM reasoning and custom question generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Database Configuration (Defaults to local SQLite for instant zero-dependency execution)
DATABASE_TYPE=sqlite
DATABASE_URL=sqlite:///database/company.db

# Optional: PostgreSQL Connection (for production deployments)
POSTGRES_READONLY_URL=postgresql://text2sql_readonly:Readonly_SafePass2026!@localhost:5432/company_db

# Security & Limits
MAX_RESULT_ROWS=1000
QUERY_TIMEOUT_SECONDS=15
DEFAULT_QUERY_LIMIT=20
CURRENT_DATE=2026-09-26
